# Скопируйте в .env.local и раскомментируйте только нужные строки.
# Пустое значение считается заданным, поэтому не оставляйте переменные пустыми.

# RPC-узел. По умолчанию публичный Devnet.
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899

# "false" отключает демо-кран и демо-KYC (/api/faucet).
# ENABLE_DEVNET_FAUCET=false

# Ключи сервера для /api/faucet: полный путь к JSON-файлу ключа (~ не раскрывается).
# Сами ключи в репозиторий не добавляйте.
# KYC_APPROVER_KEYPAIR_PATH=/absolute/path/kyc-approver.json
# FAUCET_KEYPAIR_PATH=/absolute/path/faucet.json

# Общий запасной ключ, если ролевые не заданы. По умолчанию ~/.config/solana/id.json.
# ADMIN_KEYPAIR_PATH=/absolute/path/admin.json
